# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local
.env.*.local

# Secrets and credentials
client_secrets.json
*_token.json
youtube_token.json
*-service-account*.json
neat-tube-*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
nul

# Output files (keep directory structure)
output/audio/*
output/images/*
output/videos/*
output/scripts/*
!output/**/.gitkeep

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# Claude Code
# settings.json（共有設定）は追跡する。以下は個人・セッション固有のもの。
.claude/settings.local.json
.claude/plans/

# Runtime data
# data/news/*.json は取得したニュースと、その選択状態・生成済みフラグを
# 書き換える実行時のデータストア。追跡するとアプリを動かすたびに差分が出る。
# ディレクトリ構造だけ .gitkeep で保持する。
data/news/*
!data/news/.gitkeep

# MCP server artifacts
.playwright-mcp/
.serena/
*.png
!static/**/*.png

# Node (CSS のビルドにのみ使う)
# 生成物 static/css/app.css は追跡する。アプリの実行に Node は不要。
node_modules/

# azd (環境ごとの設定と払い出し結果。キーを含むため追跡しない)
.azure/
