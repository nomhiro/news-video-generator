# ============================================================
# News Video Generator - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys

# Azure OpenAI Settings (Required)
# 台本生成と画像生成の両方で、このエンドポイントと API キーを共用する。
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key

# 台本生成モデルのデプロイ名（Azure ポータルで作成したデプロイ名を指定）
# gpt-4o は Deprecated。現行世代は gpt-5.1 / gpt-5.4 / gpt-5.6-* など。
AZURE_OPENAI_DEPLOYMENT=gpt-5.1

# 画像生成モデルのデプロイ名（Required for Image Generation）
# gpt-image-2 は GA なので個別のアクセス申請は不要。
# 重要: ここに書くのは「モデル名」ではなく Azure 上の「デプロイ名」。
#       両者は一致しないことが多い。デプロイ名は次のコマンドで確認できる:
#         az cognitiveservices account deployment list \
#           -n <resource> -g <resource-group> -o table
# 注意: 既定クォータは小さい（capacity 4 ≒ 4 images/min）。
#       ショート1本で6枚、長尺で10枚以上使うため、実用にはクォータ引き上げが必要。
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2

# 画像生成を台本生成とは別のリソースに置く場合（Optional）
#
# infra/ の azd テンプレートは画像生成専用の Foundry プロジェクトを
# 別リソースグループに払い出す。gpt-image-2 のクォータがリージョン単位で
# 上限 4 のため、台本生成のリージョンが埋まっていると別リージョンになる。
#
# 未設定なら AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY を流用する
# （単一リソースに両方のデプロイを置く構成でも動く）。
#
# 払い出し後の値は次で確認できる:
#   azd env get-values | Select-String AZURE_OPENAI_IMAGE
AZURE_OPENAI_IMAGE_ENDPOINT=https://your-image-resource.openai.azure.com
AZURE_OPENAI_IMAGE_API_KEY=your-image-resource-key

# 画像生成の同時リクエスト数（Optional, default: 3）
# クォータを引き上げたら増やせる。
IMAGE_MAX_CONCURRENCY=3

# Azure AI Speech（音声合成・Required）
#
# Google Cloud TTS から移行した。Chirp 3 HD が SSML の <mark> に対応せず、
# セグメント境界のタイミングを取得できなかったため。
# Azure AI Speech は <bookmark> で1回の合成から正確なオフセットを返す。
#
# infra/ の azd テンプレートが専用リソースグループ（rg-newsvideo-speech /
# japaneast）に払い出す。払い出し後の値は次で確認できる:
#   azd env get-values | Select-String AZURE_SPEECH
AZURE_SPEECH_API_KEY=your-speech-key
AZURE_SPEECH_REGION=japaneast

# ボイス名（Optional）
# 標準の Neural ボイスを使う。Dragon HD 系（*:MAI-Voice-*）は <prosody> に
# 対応しないため、形式別の話速（1.1〜1.25）を指定できず採用していない。
# 利用可能なボイスは次で一覧できる:
#   az cognitiveservices account list-models（ではなく）
#   https://<region>.tts.speech.microsoft.com/cognitiveservices/voices/list
AZURE_SPEECH_VOICE_JA=ja-JP-NanamiNeural
AZURE_SPEECH_VOICE_EN=en-US-AvaNeural

# OAuth トークンの保存先（Optional, default: local）
#   local : ローカルのファイル（下の *_FILE で指定したパス）
#   blob  : Azure Blob Storage（AZURE_STORAGE_ACCOUNT_URL が必須）
#
# コンテナで local だと、再起動でトークンが消えて毎回ブラウザ認証が必要になる。
# YouTube の OAuth は localhost にリダイレクトする方式なので、コンテナの中では
# 実質的に完了できない。blob にすれば、認証はローカルで1回行い、
# コンテナはそれを読むだけで済む。
#
# ローカルのトークンを blob に移すには:
#   uv run python -m scripts.push_tokens
TOKEN_STORE=local
AZURE_TOKEN_CONTAINER=tokens

# YouTube Upload Settings (Optional)
# Get credentials from Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=public

# TikTok Upload Settings (Optional)
# Get credentials from TikTok Developer Portal > Manage Apps > Your App > Credentials
# Required scopes: video.publish, video.upload
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_TOKEN_FILE=tiktok_token.json
TIKTOK_REDIRECT_URI=http://127.0.0.1:8090/callback
# Privacy: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, FOLLOWER_OF_CREATOR, SELF_ONLY
# Note: Unaudited apps can only use SELF_ONLY
TIKTOK_DEFAULT_PRIVACY=SELF_ONLY

# Web Server Settings (Optional)
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Output Settings (Optional)
# 生成の作業場所。CLI の -o で上書きできる。
# ffmpeg は外部プロセスなので、生成そのものは必ずローカルで行う。
OUTPUT_DIR=./output

# 生成物の保存先（Optional, default: local）
#   local : ローカルのファイルシステム（OUTPUT_DIR のまま）
#   blob  : Azure Blob Storage
#
# コンテナで動かすときに local だと、再起動で生成物が消え、レプリカ間でも
# 共有されない（YouTube にアップロードする前に成果物を失う）。
ARTIFACT_STORE=local

# Blob Storage の設定（ARTIFACT_STORE=blob のとき必須）
#
# 認証はアカウントキーではなく Entra ID（DefaultAzureCredential）で行う。
# ローカルは `az login`、Container Apps はマネージド ID を使う。
# ストレージアカウント側で共有キー認証を無効にしてあるので、
# キーを .env に置く経路はそもそも存在しない。
#
# 払い出し後の値は次で確認できる:
#   azd env get-values | Select-String AZURE_STORAGE
AZURE_STORAGE_ACCOUNT_URL=https://your-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=artifacts

# Database Settings (Optional)
#
# 生成の進捗（ジョブ表）を置く場所。以前は進捗をプロセスメモリに持っており、
# 再起動で消え、レプリカを増やしても共有されなかった。
#
# SQLite のファイルは1台のファイルシステム上にしかないので、
# Container Apps でレプリカを2つ以上にするなら、共有できる DB
# （Azure Database for PostgreSQL）に差し替える:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/newsvideo
DATABASE_URL=sqlite:///./data/newsvideo.db

# SQLite の journal mode（Optional, default: WAL）
# WAL は書き込み中の読み取りを許すので、ワーカーが動いている間も /status が読める。
# ただし Azure Files（SMB）の上では WAL が使えない（共有メモリを要求するため
# "disk I/O error" になる）。クラウドでファイル共有にマウントする場合は DELETE。
SQLITE_JOURNAL_MODE=WAL

# 定期実行（Optional, default: 無効）
#
# 有効にすると、毎日 SCHEDULE_TIME に「ニュース取得 → 未生成の記事を選ぶ →
# 形式ごとにジョブ投入」を行う。生成物のアップロードは行わない（人が確認して押す）。
#
# ローカルでは既定で無効。開発中に勝手に生成が走ると課金が発生するため。
SCHEDULE_ENABLED=false
SCHEDULE_TIME=06:30
SCHEDULE_TIMEZONE=Asia/Tokyo
# 作る形式（カンマ区切り）。short / tiktok / long
SCHEDULE_FORMATS=short,long
# 形式ごとの記事数。画像生成のクォータが律速なので、上げる前にクォータを上げる。
SCHEDULE_ARTICLES_PER_FORMAT=1

# News Storage Settings (Optional)
# 取得したニュース記事の保存先。選択状態や生成済みフラグもここに書かれる。
NEWS_DATA_DIR=./data/news
# 1カテゴリあたりの取得件数
NEWS_FETCH_LIMIT=10

# AI News Settings (Optional)
# Comma-separated search queries for AI-related news
# Default queries: 生成AI,ChatGPT,Claude AI,Claude Code,Gemini AI,GitHub Copilot,大規模言語モデル LLM,OpenAI,Anthropic,Stable Diffusion,Midjourney,画像生成AI
AI_SEARCH_QUERIES=生成AI,ChatGPT,Claude AI,Claude Code,Gemini AI,GitHub Copilot,LLM,OpenAI,Anthropic
# Number of articles to fetch per search query (default: 5)
AI_NEWS_LIMIT_PER_QUERY=5
