# ============================================================
# News Video Generator - Environment Variables
# ============================================================
# このファイルを .env にコピーして、各APIキーを設定してください
# Copy this file to .env and set your API keys
# ============================================================

# ============================================================
# 1. Anthropic Claude API (必須 / Required)
# ============================================================
# 取得方法: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============================================================
# 2. ElevenLabs API (必須 / Required)
# ============================================================
# 取得方法: https://elevenlabs.io/ → Profile → API Key
ELEVENLABS_API_KEY=xxxxx

# Voice IDs (オプション / Optional)
# Voice Libraryから好みの声を選択可能
# 日本語用: https://elevenlabs.io/voice-library で日本語対応ボイスを検索
ELEVENLABS_VOICE_ID_JA=EXAVITQu4vr4xnSDxMaL

# 英語用: Rachel (female), Antoni (male) など
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM

# ============================================================
# 3. fal.ai API (必須 / Required)
# ============================================================
# 取得方法: https://fal.ai/ → Dashboard → Keys
FAL_KEY=xxxxx

# ============================================================
# 4. Creatomate API (オプション / Optional)
# ============================================================
# FFmpegを使用する場合は不要
# 取得方法: https://creatomate.com/ → Project Settings → API Key
# CREATOMATE_API_KEY=xxxxx
