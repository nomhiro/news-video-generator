{
  "name": "news-video-generator-styles",
  "private": true,
  "type": "module",
  "description": "CSS のビルドにのみ使う。動画のレンダラは別パッケージ（remotion/）で、そちらは実行時に Node が必要。",
  "scripts": {
    "build:css": "tailwindcss -i static/css/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i static/css/input.css -o static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
